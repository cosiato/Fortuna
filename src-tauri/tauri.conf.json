{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Fortuna",
  "version": "0.1.8",
  "identifier": "com.givemefortuna.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Fortuna",
        "width": 1200,
        "height": 800,
        "minWidth": 800,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false,
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' https://assets.coingecko.com https://*.coingecko.com data:; connect-src 'self' https://api.coingecko.com https://query1.finance.yahoo.com https://api.exchangerate-api.com https://fonts.googleapis.com https://fonts.gstatic.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com"
    }
  },
  "bundle": {
    "createUpdaterArtifacts": true,
    "active": true,
    "targets": [
      "app",
      "dmg",
      "nsis"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "category": "Finance",
    "shortDescription": "Offline personal wealth management app",
    "longDescription": "Fortuna is an offline-first personal wealth management desktop app. Track assets, bank accounts, cash flows, and net worth with a clean and intuitive interface. All data stays on your machine.",
    "copyright": "Copyright @2026 Thomas Cosialls",
    "publisher": "Thomas Cosialls",
    "macOS": {
      "signingIdentity": "Developer ID Application: Thomas Cosialls (A5GWN75X5A)",
      "entitlements": "./Entitlements.plist",
      "minimumSystemVersion": "11.0",
      "dmg": {
        "appPosition": {
          "x": 180,
          "y": 170
        },
        "applicationFolderPosition": {
          "x": 480,
          "y": 170
        }
      }
    },
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      },
      "nsis": {
        "installMode": "currentUser"
      }
    }
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://github.com/cosiato/Fortuna/releases/latest/download/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDEzOEY5Qzc4RDhFQUMzMTcKUldRWHcrclllSnlQRS9UTnJxc0hINEQvVExib3RZL2FKSmxmMmcvbGJqSXN6Q0xsTUJ0OWJMNGMK"
    }
  }
}
